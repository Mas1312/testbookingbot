# Скопируй этот файл в .env и заполни своими значениями
# .env НЕ должен попадать в git — там будет секретный токен бота

# Токен бота от @BotFather (команда /newbot)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Публичный HTTPS-адрес твоей Mini App.
# Для локальной разработки — используй ngrok или cloudflared (см. README.md)
WEBAPP_URL=https://your-ngrok-url.ngrok-free.app

SERVER_PORT=8000

# Название твоего бизнеса — покажется в шапке Mini App
BUSINESS_NAME=Моя запись

# Твой личный Telegram ID — именно тебе (и только тебе) будет доступна админ-панель
# внутри Mini App. Узнать свой ID можно, написав боту @userinfobot.
OWNER_TG_ID=123456789
